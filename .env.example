# uFlex Edge Gateway — environment variables
#
# Copy this file to `.env` and fill in the values for your edge.
# `.env` is gitignored: never commit real credentials.

# Base URL of the uFlex REST API (scheme://host:port), without the /api/v1 suffix.
UFLEX_BACKEND_URL=http://localhost:8080

# Service-account credentials for this edge (provisioned per home at install time).
UFLEX_EDGE_EMAIL=
UFLEX_EDGE_PASSWORD=

# Serial of the single kit this edge serves (1 edge <-> 1 kit).
UFLEX_KIT_SERIAL=uflex-kit-001
